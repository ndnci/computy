{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Computy",
  "version": "0.1.5",
  "identifier": "com.ndnci.computy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-native-extras.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Computy \u2014 Votre mat\u00e9riel, en clair.",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#f5f7f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Comprenez, testez et suivez votre mat\u00e9riel.",
    "copyright": "NDNCI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "pkexec"
        ],
        "recommends": [
          "grub2-common"
        ],
        "files": {
          "/boot/computy-memory.efi": "../third_party/computy-memory-boot/build/x86_64/mt86plus",
          "/usr/libexec/computy-boot-helper": "target/boot-helper/release/computy-boot-helper",
          "/etc/grub.d/41_computy_memory": "../packaging/41_computy_memory",
          "/usr/share/polkit-1/actions/org.ndnci.computy.boot.policy": "../packaging/org.ndnci.computy.boot.policy",
          "/usr/share/doc/computy/memory-boot-sources.tar.gz": "target/boot-helper/computy-memory-sources.tar.gz",
          "/usr/share/doc/computy/memory-boot-LICENSE": "../third_party/computy-memory-boot/LICENSE"
        },
        "postInstallScript": "../packaging/postinst",
        "postRemoveScript": "../packaging/postrm"
      }
    },
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  }
}
