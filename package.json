{
  "name": "computy",
  "version": "0.4.0",
  "private": true,
  "description": "Comprendre, tester et suivre la santé de son ordinateur.",
  "type": "module",
  "scripts": {
    "build:engine": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "node --test tests/*.test.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "test:desktop": "scripts/gpui-docker.sh cargo test --manifest-path desktop/Cargo.toml",
    "desktop": "scripts/gpui-docker.sh cargo build --release --manifest-path desktop/Cargo.toml",
    "package": "scripts/gpui-docker.sh scripts/package-deb.sh",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:intl": "node scripts/generate-intl.mjs",
    "visual:capture": "scripts/gpui-docker.sh python3 scripts/visual/capture-gpui.py",
    "visual:compare": "python3 scripts/visual/compare-visual.py",
    "benchmark": "python3 scripts/benchmark-desktop.py",
    "docker:test": "docker compose run --build --rm verify",
    "format": "prettier --write scripts/*.mjs scripts/*.cjs scripts/visual/*.mjs tests/*.mjs",
    "format:check": "prettier --check scripts/*.mjs scripts/*.cjs scripts/visual/*.mjs tests/*.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "lucide-react": "^1.63.0",
    "prettier": "^3.9.10"
  },
  "license": "GPL-3.0-only"
}
