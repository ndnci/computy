{
  "name": "computy",
  "version": "0.1.0",
  "private": true,
  "description": "Comprendre, tester et suivre la sant\u00e9 de son ordinateur.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:engine": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "node --test tests/*.test.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "test:e2e": "npm run test:ui",
    "package": "tauri build",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml",
    "docker:dev": "docker compose up --build dev",
    "docker:test": "docker compose run --build --rm verify",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:desktop": "node scripts/check-desktop.mjs",
    "format": "prettier --write src scripts/*.mjs scripts/*.cjs tests/*.mjs vite.config.mjs",
    "format:check": "prettier --check src scripts/*.mjs scripts/*.cjs tests/*.mjs vite.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "i18next": "^26.5.11",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.11",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
